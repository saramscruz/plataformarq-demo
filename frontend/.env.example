# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Anthropic Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Sheets (service account JSON key, base64 encoded)
GOOGLE_SERVICE_ACCOUNT_KEY=base64-encoded-service-account-json
GOOGLE_SHEETS_SIGNAL_LOG_ID=your-google-sheet-id

# Gmail IMAP for Google Alerts
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Email alerts (for system notifications)
ALERT_EMAIL_TO=saramscruz@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password

# Database (leave empty to use SQLite for local dev)
DATABASE_URL=

# Demo mode (set to "true" to skip auth and use seed data)
DEMO_MODE=true
